# Copy this file to `.env` (or export these as environment variables).
# Never commit real keys to git.

# --- AI document reading (review-only) ---
# Any OpenAI-compatible /chat/completions endpoint.
# Free example (OpenRouter): base URL + a free model slug.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-...
AI_MODEL=nvidia/nemotron-3.5-lightning:free

# --- Optional hardening ---
# Set SEED_DEMO=0 in production to stop creating demo users on startup.
# SEED_DEMO=0

# --- Database / app (already defaulted in app/config.py) ---
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/obm_sales
# SECRET_KEY=change-me